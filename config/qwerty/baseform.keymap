#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
// #include "../layer_defs.dtsi"
// #include "../keymap_edges.dtsi"

#define QWE 0
#define MSE 1
#define NAV 2
#define FUN 3
#define SYM 4
#define NUM 5

#define XXXXXX &none
#define ______ &trans
#define HRM_L(k1, k2, k3, k4) &htl LCTRL k1 &htl LALT k2   &htl LSHIFT k3 &htl LGUI k4
#define HRM_R(k1, k2, k3, k4) &htr LGUI k1  &htr LSHIFT k2 &htr RALT k3   &htr LCTRL k4
#define TBL_1 &mo MOUSE
#define TBL_2 &lt NAV ESC
#define TBL_3 &mt LCTL LALT SPACE
#define TBR_1 &lt FUN RET
#define TBR_2 &mo SYM 
#define TBR_3 &kp CAPS

&lt {
  tapping-term-ms = <160>;
  quick_tap_ms = <160>;
};

&soft_off {
    hold-time-ms = <2000>; 
};

/ {

  behaviors {
    // hm: htt {
    //   compatible = "zmk,behavior-hold-tap";
    //   label = "HOLD_TAP_TUNED";
    //   #binding-cells = <2>;
    //   tapping-term-ms = <170>;
    //   quick_tap_ms = <170>;
    //   flavor = "tap-preferred";
    //   bindings = <&kp>, <&kp>;
    // };

    htl: ht_left {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      bindings = <&kp>,  <&kp>;

      flavor = "balanced";
      tapping-term-ms = <300>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;

      hold-trigger-key-positions = <
        6  7  8  9 10 11
        18 19 20 21 22 23
        30 31 32 33 34 35
        42 43 44 45 46 47
        51 52 53
      >;
      hold-trigger-on-release;
    };

    htr: ht_right {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      bindings = <&kp>, <&kp>;

      flavor = "balanced";
      tapping-term-ms = <300>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;

      hold-trigger-key-positions = <
        0  1  2  3  4  5
        12 13 14 15 16 17
        24 25 26 27 28 29
        36 37 38 39 40 41
        48 49 50
      >;
      hold-trigger-on-release;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      display-name = "base";
      bindings = <
        // ROW4
        // ROW3( &kp Q        &kp W       &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I      &kp O         &kp P          )
        // ROW2( &kp A        &kp S       &kp D  &kp F  &kp G    &kp H  &kp J  &kp K      &kp L         &kp APOS       )
        // ROW1( &hm LCTRL Z  &hm LALT X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &hm RALT DOT  &hm RCTRL COLON )
        // THUMB_ROW

        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
            XXXXXX     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     &kp Q      &kp W      &kp E      &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P      &kp DEL
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp TAB    HRM_L(A,   S,         D,         F)         &kp G          &kp H      HRM_R(J,   K,         L,         APOS)      &kp BSPC
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     &kp Z      &kp X      &kp C      &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLASH  XXXXXX
        //╰──────────┴──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────┴──────────╯
                                             TBL_1      TBL_2      TBL_3          TBR_1      TBR_2      TBR_3
        //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
      >;
    };

    mouse {
      display-name = "mouse";
      bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            ______     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     ______
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
