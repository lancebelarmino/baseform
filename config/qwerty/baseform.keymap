    navigation {
      display-name = "navigate";
      bindings = <
        // TRANS_ROW
        // TRANS_FLANK( &kp PRCNT  &kp N7  &kp N8    &kp N9  &kp PLUS        &none      &kp HOME   &kp UP    &kp PG_UP    &none     )
        // TRANS_FLANK( &kp DOT    &kp N4  &kp N5    &kp N6  &kp MINUS       &none      &kp LEFT   &kp DOWN  &kp RIGHT    &none     )
        // TRANS_FLANK( &kp COMMA  &kp N1  &kp N2    &kp N3  &kp ASTRK       &none      &kp END    &kp DOWN  &kp PG_DN    &none     )
        //                                 &kp EQUAL &kp N0  &kp FSLH        &trans     &none      &trans

        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            ______     &kp LCTRL  &kp LALT   &kp LSHFT  &kp LGUI   XXXXXX         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  XXXXXX     ______
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //╰──────────┴──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────┴──────────╯
                                             ______     ______     ______         ______     ______     ______
        //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
      >;
    };

    function {
      display-name = "function";
      bindings = <
        // TRANS_ROW
        // TRANS_FLANK( &kp C_BRI_UP  &kp F7  &kp F8  &kp F9  &kp F10      &none         &none         &none      &none       &none      )
        // TRANS_FLANK( &kp C_BRI_DN  &kp F4  &kp F5  &kp F6  &kp F11      &kp KP_NUM    &kp CAPS      &kp SLCK   &kp PSCRN   &kp INS    )
        // TRANS_FLANK( &none         &kp F1  &kp F2  &kp F3  &kp F12      &kp C_VOL_UP  &kp C_VOL_DN  &kp C_PP   &kp C_NEXT  &kp C_PREV )
        //                                    &kp ESC &trans  &trans       &none         &trans        &trans


        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     &kp F1     &kp F2     &kp F3     &kp F4     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            ______     &kp F5     &kp F6     &kp F7     &kp F8     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     ______
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     &kp F9     &kp F10    &kp F11    &kp F12    XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //╰──────────┴──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────┴──────────╯
                                             ______     ______     ______         ______     ______     ______
        //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
      >;
    };

    symbols {	
      display-name = "symbols";
      bindings = <
        // TRANS_ROW
        // TRANS_FLANK( &kp PRCNT  &kp LPAR   &kp LT     &kp LBKT   &kp LBRC     &kp RBRC   &kp RBKT  &kp GT    &kp RPAR  &kp ASTRK )
        // TRANS_FLANK( &kp TILDE  &kp SEMI   &kp EXCL   &kp QMARK  &kp UNDER    &kp EQUAL  &kp AT    &kp HASH  &kp COLN  &kp CARET )
        // TRANS_FLANK( &none      &kp GRAVE  &kp AMPS   &kp FSLH   &kp PLUS     &kp MINUS  &kp BSLH  &kp DLLR  &kp PIPE  &none     )
        //                                    &trans     &none      &trans       &trans     &trans    &trans

        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            ______     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     KC_EQL     XXXXXX     XXXXXX     XXXXXX     ______
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     ______     ______     ______     XXXXXX
        //╰──────────┴──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────┴──────────╯
                                             ______     ______     ______         ______     ______     ______
        //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
      >;
    };

    numbers {	
      display-name = "numbers";
      bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
            XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            XXXXXX     XXXXXX     &kp N1     &kp N2     &kp N3     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
            ______     &kp N0     &kp N4     &kp N5     &kp N6     XXXXXX         XXXXXX     XXXXXX     XXXXXX     XXXXXX     XXXXXX     ______
        //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
